{
  "expo": {
    "name": "OUTHERENOW",
    "slug": "outhere",
    "scheme": "outhere",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF3E6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.outherenow.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.outherenow.app",
      "adaptiveIcon": {
        "backgroundColor": "#3B2A55",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OUTHERENOW uses your approximate location to show spots near you and to send alerts about camps within your chosen radius."
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "OUTHERENOW adds camps you choose to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OUTHERENOW uses your photos so you can add a profile picture and camp photos.",
          "cameraPermission": "OUTHERENOW uses the camera so you can take a profile picture or camp photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
